# PostgreSQL
POSTGRES_DB=jev_ai
POSTGRES_USER=jev_ai
POSTGRES_PASSWORD=change_me

# API
BACKEND_PORT=8000

# PostgreSQL y Redis solo son accesibles desde la red interna de Compose.
# Compose construye DATABASE_URL dentro de la red usando las variables POSTGRES_*.

# LLM
# Usa "mock" para desarrollo offline y "openai" para el proveedor real.
LLM_PROVIDER=mock
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# JEV (TypeSafe System One)
# Usa "mock" para desarrollo offline y "typesafe" para el cliente real.
JEV_PROVIDER=mock
# TYPESAFE_API_KEY=...
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=120
JEV_MAX_RETRIES=2
